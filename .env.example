# PostgreSQL
POSTGRES_DB=isp_workflow
POSTGRES_USER=isp_user
POSTGRES_PASSWORD=isp_pass

# Server
SERVER_PORT=8080

# Datasource (production)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/isp_workflow
SPRING_DATASOURCE_USERNAME=isp_user
SPRING_DATASOURCE_PASSWORD=isp_pass

# JWT
APP_JWT_SECRET=change-this-to-a-long-random-secret-key

# Auth
APP_DEFAULT_PASSWORD=changeme
ALLOWED_EMAILS=admin@example.com

# Mail (Gmail SMTP)
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Google OAuth2 (GIS — only client ID needed, secret not used)
GOOGLE_CLIENT_ID=

# Frontend / CORS
APP_FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
